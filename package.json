{
  "name": "gcode-preview-react",
  "version": "0.1.0",
  "private": true,
  "description": "React component for gcode-preview: a 3D preview of G-code files in a canvas",
  "keywords": [
    "gcode",
    "g-code",
    "gcode-preview",
    "3d-printing",
    "preview",
    "react",
    "react-component",
    "threejs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyz-tools/gcode-preview-react.git"
  },
  "homepage": "https://github.com/xyz-tools/gcode-preview-react#readme",
  "bugs": {
    "url": "https://github.com/xyz-tools/gcode-preview-react/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run clean && tsc -p tsconfig.lib.json",
    "build:demo": "tsc --noEmit && vite build",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "preview": "vite preview",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "publint",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc.json"
  },
  "peerDependencies": {
    "gcode-preview": "^3.0.0-alpha.6",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gcode-preview": "3.0.0-alpha.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
